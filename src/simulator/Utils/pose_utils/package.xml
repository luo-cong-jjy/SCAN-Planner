<!--
  ROS 包清单：name 决定 rospack/roslaunch 的包标识，依赖声明用于构建、运行和部署解析。
  节点和库的具体生成关系由同目录 CMakeLists.txt 定义；清单本身不启动进程。
-->
<package>
  <name>pose_utils</name>
  <version>0.0.0</version>
  <description>pose_utils</description>
  <maintainer email="eeshaojie@todo.todo">Shaojie Shen</maintainer>
  <license>BSD</license>
  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>roscpp</build_depend>
  <run_depend>roscpp</run_depend>
  <export>
    <cpp cflags="-I${prefix}/include"
         lflags="-Wl,-rpath,${prefix}/lib -L${prefix}/lib"/>
  </export>

</package>
